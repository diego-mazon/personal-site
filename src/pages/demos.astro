---
import '../styles/tailwind-utilities.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import CausalDecisionTree from '../components/demos/CausalDecisionTree.jsx';
---

<BaseLayout title="Demos — Diego Mazon" description="Interactive component demos.">
  <h1>Demos</h1>
  <p class="muted">
    Small interactive components, each a plain <code>.jsx</code> file under
    <code>src/components/demos/</code>, hydrated client-side with Astro's
    React integration. Everything else on this site ships no JavaScript.
  </p>

  <CausalDecisionTree client:load />
</BaseLayout>
